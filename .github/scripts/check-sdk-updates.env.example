# check-sdk-updates.mjs 実行用の環境変数サンプル
# 実行前にこのファイルをコピーして値を設定してください（機密値はコミットしない）。

# Issue を作成する先のリポジトリ。未指定なら GITHUB_REPOSITORY を使用。
ISSUE_REPOSITORY=owner/repo

# GitHub Actions 上では自動設定されることが多い。
GITHUB_REPOSITORY=owner/repo

# GitHub API へ Issue 作成するトークン（repo スコープ）。
# dry-run の場合は未設定でも実行可能。
GH_TOKEN=
# 代替名
GITHUB_TOKEN=

# true なら Issue 作成せず、検出結果のみ出力。
DRY_RUN=true

# 既定: sdk-update,enhancement
ISSUE_LABELS=sdk-update,enhancement

# upstream 参照で API 制限を避けたい場合に指定（任意）
UPSTREAM_GITHUB_TOKEN=
